# --- LLM configuration (xAI Grok API) -----------------------------------
LLM_PROVIDER=grok
XAI_API_KEY=xai-your-api-key-here
XAI_MODEL=grok-4-latest
XAI_BASE_URL=https://api.x.ai/v1/chat/completions

# --- Demo Mode ------------------------------------------------------------
# When true, the app runs WITHOUT calling any LLM. All dataset analysis is
# still 100% real (same tools, same Excel file); only the "reasoning" step
# becomes a deterministic, documented rule-based plan instead of an LLM
# driving the tool-call loop. Useful for grading/demoing without an API key.
DEMO_MODE=false
