# --- LLM configuration (Google Gemini API) -------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
# Optional fallback; leave blank unless your Google account supports another model.
GEMINI_FALLBACK_MODEL=

# --- Demo Mode ------------------------------------------------------------
# When true, the app runs WITHOUT calling any LLM. All dataset analysis is
# still 100% real (same tools, same Excel file); only the "reasoning" step
# becomes a deterministic, documented rule-based plan instead of an LLM
# driving the tool-call loop. Useful for grading/demoing without an API key.
DEMO_MODE=false
# Optional: only set this when FastAPI is deployed at a public URL.
# Leave it blank for embedded Streamlit/Streamlit Cloud operation.
API_URL=
